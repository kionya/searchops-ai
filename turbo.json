{
    "$schema":  "https://turbo.build/schema.json",
    "tasks":  {
                  "build":  {
                                "dependsOn":  [
                                                  "^build"
                                              ],
                                "outputs":  [
                                                "dist/**",
                                                "src/generated/prisma/**",
                                                ".prisma/client/**",
                                                ".next/**",
                                                "!.next/cache/**"
                                            ]
                            },
                  "dev":  {
                              "cache":  false,
                              "persistent":  true
                          },
                  "lint":  {
                               "dependsOn":  [
                                                 "^lint"
                                             ]
                           },
                  "test":  {
                               "dependsOn":  [
                                                 "^build"
                                             ],
                               "outputs":  [

                                           ]
                           },
                  "typecheck":  {
                                    "dependsOn":  [
                                                      "^build"
                                                  ]
                                }
              }
}
