# Copy values into the ignored root file .env.api.local.
NODE_ENV="development"
DATABASE_URL="postgresql://searchops:searchops@localhost:5432/searchops_ai?schema=public"
DIRECT_DATABASE_URL="postgresql://searchops:searchops@localhost:5432/searchops_ai?schema=public"
REDIS_URL="redis://localhost:6379"
PORT="4000"
SEARCHOPS_API_HOST="127.0.0.1"
SEARCHOPS_API_BASE_URL="http://localhost:4000"
SEARCHOPS_PUBLIC_APP_URL="http://localhost:3000"

# Optional encrypted ProviderAccount storage. Keep all four unset for fixture-only local work.
# API and Worker values must be identical. Never commit generated key material.
# SEARCHOPS_CREDENTIAL_STORAGE_MODE="dual"
# SEARCHOPS_CREDENTIAL_ENCRYPTION_KEY_ID="local-v1"
# SEARCHOPS_CREDENTIAL_ENCRYPTION_KEY="paste-32-byte-base64-value-here"
# SEARCHOPS_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS_JSON="{}"

# Optional Google OAuth setup. Leave all four unset for fixture mode.
# SEARCHOPS_GOOGLE_OAUTH_CLIENT_ID="synthetic-client-id.apps.googleusercontent.com"
# SEARCHOPS_GOOGLE_OAUTH_CLIENT_SECRET="synthetic-client-secret"
# SEARCHOPS_GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/connectors/google/oauth/callback"
# SEARCHOPS_GOOGLE_OAUTH_STATE_SECRET="synthetic-state-secret-at-least-16-chars"
