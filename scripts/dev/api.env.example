# Copy values into the ignored root file .env.api.local.
DATABASE_URL="postgresql://searchops:searchops@localhost:5432/searchops_ai?schema=public"
DIRECT_DATABASE_URL="postgresql://searchops:searchops@localhost:5432/searchops_ai?schema=public"
REDIS_URL="redis://localhost:6379"
PORT="4000"
SEARCHOPS_API_HOST="127.0.0.1"
SEARCHOPS_API_BASE_URL="http://localhost:4000"
SEARCHOPS_PUBLIC_APP_URL="http://localhost:3000"

# Optional Google OAuth setup. Leave all four unset for fixture mode.
# SEARCHOPS_GOOGLE_OAUTH_CLIENT_ID="replace-with-client-id"
# SEARCHOPS_GOOGLE_OAUTH_CLIENT_SECRET="replace-with-client-secret"
# SEARCHOPS_GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/connectors/google/oauth/callback"
# SEARCHOPS_GOOGLE_OAUTH_STATE_SECRET="replace-with-at-least-16-random-chars"
