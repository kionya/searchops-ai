# Copy values into the ignored root file .env.worker.local.
NODE_ENV="development"
DATABASE_URL="postgresql://searchops:searchops@localhost:5432/searchops_ai?schema=public"
DIRECT_DATABASE_URL="postgresql://searchops:searchops@localhost:5432/searchops_ai?schema=public"
REDIS_URL="redis://localhost:6379"
SEARCHOPS_API_BASE_URL="http://localhost:4000"

# Optional encrypted ProviderAccount storage. Use the exact same values as the API.
# SEARCHOPS_CREDENTIAL_STORAGE_MODE="dual"
# SEARCHOPS_CREDENTIAL_ENCRYPTION_KEY_ID="local-v1"
# SEARCHOPS_CREDENTIAL_ENCRYPTION_KEY="paste-32-byte-base64-value-here"
# SEARCHOPS_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS_JSON="{}"

# Worker refreshes stored Google accounts with the same OAuth app client used by the API.
# SEARCHOPS_GOOGLE_OAUTH_CLIENT_ID="synthetic-client-id.apps.googleusercontent.com"
# SEARCHOPS_GOOGLE_OAUTH_CLIENT_SECRET="synthetic-client-secret"

# Optional SearchOps-owned platform credentials. Site IDs and customer keys belong in the UI/DB.
# SEARCHOPS_PAGESPEED_API_KEY="synthetic-pagespeed-platform-key"
# SEARCHOPS_GEO_CHATGPT_API_KEY="synthetic-searchops-funded-key"
# SEARCHOPS_GEO_CLAUDE_API_KEY="synthetic-searchops-funded-key"
# SEARCHOPS_GEO_GEMINI_API_KEY="synthetic-searchops-funded-key"
# SEARCHOPS_GEO_PERPLEXITY_API_KEY="synthetic-searchops-funded-key"
